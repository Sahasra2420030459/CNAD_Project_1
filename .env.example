# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR CLOUD VIDEO COMPRESSION PLATFORM
# ==============================================================================
# Copy this file to .env before running locally or use these variables in your
# cloud hosting dashboard (e.g., Render, Railway, Azure, Docker).

# ------------------------------------------------------------------------------
# 1. Application Profile Selection
# ------------------------------------------------------------------------------
# Values:
#   h2    -> Zero-install local testing (persisted embedded file database, no MySQL needed)
#   local -> Local Docker or local MySQL server
#   prod  -> Cloud-hosted production (Remote Cloud MySQL like Aiven/TiDB/Railway, SSL enabled)
#   azure -> Microsoft Azure deployment (Blob Storage, Queue Storage, Azure MySQL)
SPRING_PROFILES_ACTIVE=h2

# Server Port (Auto-detected from hosting platforms like Render via $PORT)
PORT=8080
PORT_BACKEND=8080
PORT_FRONTEND=3000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Set these when SPRING_PROFILES_ACTIVE=local or SPRING_PROFILES_ACTIVE=prod
DB_HOST=your-mysql-hostname.example.com
DB_PORT=3306
DB_NAME=videoplatform
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
# Set DB_USE_SSL=true for remote cloud databases (Aiven, TiDB, Azure, Clever Cloud)
DB_USE_SSL=true

# Optional unified connection URL (provided automatically by Render/Railway):
# JDBC_DATABASE_URL=jdbc:mysql://<host>:3306/videoplatform?useSSL=true

# ------------------------------------------------------------------------------
# 3. JWT Security & Authentication
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key for production HMAC-SHA256 signing
JWT_SECRET=your_secure_256_bit_secret_key_minimum_32_characters_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains or pattern)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app,https://*.onrender.com

# ------------------------------------------------------------------------------
# 4. Storage Configuration
# ------------------------------------------------------------------------------
# Values: 'local' (disk storage) or 'azure' (Azure Blob Storage)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# Required ONLY if STORAGE_TYPE=azure:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your_account>;AccountKey=<your_key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=video-processing

# ------------------------------------------------------------------------------
# 5. Asynchronous Queue Configuration
# ------------------------------------------------------------------------------
# Values: 'local' (in-memory & DB polling fallback) or 'azure' (Azure Queue Storage)
QUEUE_TYPE=local

# Required ONLY if QUEUE_TYPE=azure:
AZURE_QUEUE_NAME=video-compression-jobs

# ------------------------------------------------------------------------------
# 6. Worker & FFmpeg Configuration
# ------------------------------------------------------------------------------
# 'auto' uses FFmpeg if installed, otherwise safely simulates compression
WORKER_FFMPEG_SIMULATION_MODE=auto
WORKER_POLL_INTERVAL_MS=3000
EMBEDDED_WORKER_ENABLED=true

# ------------------------------------------------------------------------------
# 7. Frontend Environment (Used when building React frontend)
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8080/api
