# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR CLOUD VIDEO COMPRESSION PLATFORM
# ==============================================================================

# Application Profile: 'local' (zero Azure cloud required) or 'azure'
SPRING_PROFILES_ACTIVE=local
PORT_BACKEND=8080
PORT_FRONTEND=3000

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / Azure Database for MySQL Flexible Server)
# ------------------------------------------------------------------------------
# For local Docker or standalone MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=videoplatform
DB_USERNAME=root
DB_PASSWORD=rootpassword
# Set to 'true' for Azure Database for MySQL with SSL:
DB_USE_SSL=false

# ------------------------------------------------------------------------------
# JWT Security Configuration
# ------------------------------------------------------------------------------
# Secure random 256-bit key for HMAC-SHA256 signing (change in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Storage Configuration
# Values: 'local' (disk storage in ./uploads) or 'azure' (Azure Blob Storage)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads
# Azure Blob Storage (Required only when STORAGE_TYPE=azure)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your_account>;AccountKey=<your_key>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=video-processing

# ------------------------------------------------------------------------------
# Asynchronous Queue Configuration
# Values: 'local' (in-memory / scheduled polling) or 'azure' (Azure Queue Storage)
# ------------------------------------------------------------------------------
QUEUE_TYPE=local
# Azure Queue Storage (Required only when QUEUE_TYPE=azure)
AZURE_QUEUE_NAME=video-compression-jobs

# ------------------------------------------------------------------------------
# Worker & FFmpeg Configuration
# ------------------------------------------------------------------------------
# 'auto' uses ffmpeg if present in PATH, otherwise safely simulates compression
WORKER_FFMPEG_SIMULATION_MODE=auto
WORKER_POLL_INTERVAL_MS=3000
WORKER_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Frontend Environment
# ------------------------------------------------------------------------------
REACT_APP_API_BASE_URL=http://localhost:8080/api
